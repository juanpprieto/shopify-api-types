# Copy this file to .env and add your values. Git ignores .env.
# npm run fetch-schemas and npm run docs load it. Its values win over shell
# variables with the same name.

# Shopify tokens for npm run fetch-schemas

# Store name without .myshopify.com (for mystore.myshopify.com, use mystore)
SHOPIFY_STORE_DOMAIN=your-store-name

# Shopify Admin > Apps > Develop apps > your app > Storefront API
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token

# Customer Account API access token
SHOPIFY_CUSTOMER_ACCOUNT_ACCESS_TOKEN=your-customer-account-token

# Shopify Admin > Apps > Develop apps > your app > Admin API (read access)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token

# OpenCode Go key for npm run docs (README generation)
OPENCODE_GO_API_KEY=your-opencode-go-key

# Optional: model override. The default is in scripts/lib/opencode-go.ts.
# OPENCODE_GO_MODEL=kimi-k3.1-pro

# Optional: build the version set for another date (back-dated releases only)
# RELEASE_DATE=2026-01-15
