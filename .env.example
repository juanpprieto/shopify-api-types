# Shopify API Types - Environment Variables
# Copy this file to .env and add your actual values

# =============================================================================
# REQUIRED: Shopify API Tokens for Schema Fetching
# =============================================================================

# Store domain (without .myshopify.com suffix) - required for Admin/Storefront API
# Example: if your store is https://mystore.myshopify.com, use "mystore"
SHOPIFY_STORE_DOMAIN=your-store-name

# Storefront API Access Token
# Get from: Shopify Admin > Apps > Develop apps > Create private app > Storefront API
# Required permissions: Read access to Products, Collections, etc.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token

# Customer Account API Access Token
# Get from: Shopify Partners Dashboard or Customer Account API documentation
# Required for fetching Customer Account API schema
SHOPIFY_CUSTOMER_ACCOUNT_ACCESS_TOKEN=your-customer-account-token

# Admin API Access Token
# Get from: Shopify Admin > Apps > Develop apps > Create private app > Admin API
# Required permissions: Read access to GraphQL Admin API
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token

# =============================================================================
# REQUIRED: AI Documentation Generation
# =============================================================================

# Anthropic API Key for AI-powered README generation
# Get from: https://console.anthropic.com/settings/keys
# Required for: npm run docs (generate-docs.ts)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# Claude Model Selection (optional)
# If not set, automatically uses:
#   - Development: claude-sonnet-4-0 (latest alias)
#   - Production: claude-sonnet-4-20250514 (specific version)
# Examples:
#   ANTHROPIC_MODEL=claude-opus-4-1-20250805
#   ANTHROPIC_MODEL=claude-sonnet-4-0
# ANTHROPIC_MODEL=

# Node Environment (optional)
# Controls model selection behavior and other environment-specific settings
# Values: development, production, test
# NODE_ENV=development

# =============================================================================
# DEVELOPMENT: Local Testing
# =============================================================================

# Enable debug output for schema fetching (optional)
# DEBUG=shopify:*

# =============================================================================
# CI/CD: GitHub Actions
# =============================================================================

# GitHub Token (automatically provided in GitHub Actions)
# Required for creating releases and PRs
# GITHUB_TOKEN=ghp_your-github-token

# NPM Token (required for publishing)
# Get from: https://www.npmjs.com/settings/your-username/tokens
# Add as GitHub Secret: NPM_TOKEN
# NPM_TOKEN=npm_your-npm-token

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit the .env file to version control
# 2. Add all tokens as GitHub Secrets for CI/CD workflows
# 3. For local development, copy this file to .env and fill in your values
# 4. All SHOPIFY_* tokens are required for schema fetching (npm run fetch-schemas)
# 5. ANTHROPIC_API_KEY is required for documentation generation (npm run docs)