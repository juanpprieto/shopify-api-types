# Shopify API Tokens for Schema Fetching
# Copy this file to .env and add your actual tokens

# Store domain (without .myshopify.com suffix) - required for Admin API
# Example: if your store is https://mystore.myshopify.com, use "mystore"
SHOPIFY_STORE_DOMAIN=your_store_name

# Storefront API Access Token
# Get from: Shopify Admin > Apps > Develop apps > Create private app > Storefront API
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token_here

# Customer Account API Access Token  
# Get from: Shopify Partners Dashboard or Customer Account API documentation
SHOPIFY_CUSTOMER_ACCOUNT_ACCESS_TOKEN=your_customer_account_token_here

# Admin API Access Token
# Get from: Shopify Admin > Apps > Develop apps > Create private app > Admin API
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_token_here

# Anthropic API Key for AI-powered README generation
# Get from: https://console.anthropic.com/settings/keys
# Required for: npm run docs (generate-docs.ts)
ANTHROPIC_API_KEY=your_anthropic_api_key_here