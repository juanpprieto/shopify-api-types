{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Third-party .d.ts conflicts (hoisted @types in parent dirs) are not
    // actionable here; project code stays fully strict.
    "skipLibCheck": true
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "dist/**/*",
    "**/*.d.ts",
    "src/schemas/**/*.json",
    "scripts/validate-build.ts",
    "tests/e2e/**/*",
    "src/**/types.ts"
  ]
}
