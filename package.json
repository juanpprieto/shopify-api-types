    "eslint-plugin-prettier": "5.5.4",
    "graphql": "16.11.0",
    "husky": "9.1.7",
    "knip": "5.62.0",
    "lint-staged": "16.1.5",
    "prettier": "3.6.2",
    "ts-prune": "0.10.3",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vite": "7.1.2",
    "vitest": "3.2.4"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --ignore-path .prettierignore",
    "type-check": "tsc --noEmit --project tsconfig.check.json",
    "type-check:watch": "tsc --noEmit --watch",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.mjs",
    "check": "npm run type-check && npm run lint:check",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "prebuild": "npm run clean && npm run generate-exports",
    "build": "npm run build:declarations && npm run postbuild",
    "build:declarations": "tsc --emitDeclarationOnly --project tsconfig.build.json",
    "postbuild": "npm run copy-schemas",
    "clean": "rm -rf dist .tsbuildinfo",
    "generate-exports": "tsx scripts/generate-exports.ts",
    "copy-schemas": "tsx scripts/copy-schemas.ts",
    "validate-build": "tsx scripts/validate-build.ts",
    "build:check": "npm run build && npm run validate-build",
    "knip": "knip",
    "knip:production": "knip --production",
    "knip:strict": "knip --strict --include files,dependencies,unlisted,exports",
    "knip:fix": "knip --fix --allow-remove-files",
    "deadcode": "knip --production --strict",
    "deadcode:ci": "knip --production --strict --reporter json",
    "find-deadcode": "ts-prune",
    "find-deadcode:strict": "ts-prune -e",
    "unused-exports": "ts-prune | grep -v test | grep -v spec",
    "cleanup:analyze": "npm run deadcode && npm run find-deadcode:strict",
    "cleanup:check": "npm run knip:strict && npm run find-deadcode:strict",
    "cleanup:fix": "npm run knip:fix",
    "fetch-schemas": "tsx scripts/fetch-schemas.ts",
    "validate-schemas": "tsx scripts/validate-schemas.ts",
    "schemas:update": "npm run fetch-schemas && npm run validate-schemas",
    "generate-types": "graphql-codegen --config scripts/codegen.ts",
    "generate-indexes": "tsx scripts/generate-indexes.ts",
    "validate-types": "tsx scripts/validate-types.ts",
    "build:types": "npm run fetch-schemas && npm run generate-types",
    "postgenerate-types": "npm run format && npm run generate-indexes",
    "docs": "tsx scripts/generate-docs.ts",
    "count-types": "tsx scripts/count-types.ts",
    "release": "tsx scripts/release.ts",
    "release:dry": "tsx scripts/release.ts --dry-run",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "version": "tsx scripts/calver-version.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "bash -c 'npm run check'",
      "bash -c 'npm test'"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "_comment": "Note: deadcode check temporarily disabled in lint-staged for Phase 2. Lib files are used by scripts but not in production mode. Will re-enable in Phase 3 when proper exports are added."
}
