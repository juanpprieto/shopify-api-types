{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/index.ts", "src/*/index.ts", "src/*/*/index.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "scripts",
    "tests",
    "node_modules",
    "dist"
  ]
}
